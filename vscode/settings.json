{
    // ============================================================
    // CORE EDITOR SETTINGS
    // ============================================================
    "editor.cursorStyle": "line",
    "editor.insertSpaces": true,
    "editor.lineNumbers": "on",
    "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.minimap.enabled": true,
    "editor.rulers": [
        88
    ],
    "editor.wordWrap": "off",
    "editor.wordWrapColumn": 100,
    "editor.renderWhitespace": "boundary",
    "editor.defaultColorDecorators": "always",
    "editor.formatOnSave": true,
    "editor.guides.bracketPairs": true,
    "editor.inlineSuggest.enabled": true,
    "editor.linkedEditing": true,
    "editor.suggest.showInlineDetails": true,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.tokenColorCustomizations": {
        "[*Light*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#000"
                    }
                }
            ]
        },
        "[*Dark*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#fff"
                    }
                }
            ]
        },
        "textMateRules": [
            {
                "scope": "meta.function-call.generic",
                "settings": {
                    "foreground": "#DCDCAA"
                }
            }
        ]
    },
    // ============================================================
    // WORKBENCH & UI SETTINGS
    // ============================================================
    "workbench.startupEditor": "welcomePage",
    "workbench.editor.scrollToSwitchTabs": true,
    "workbench.commandPalette.history": 50,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "window.customTitleBarVisibility": "auto",
    "window.menuBarVisibility": "compact",
    "window.titleBarStyle": "custom",
    "breadcrumbs.enabled": true,
    "breadcrumbs.filePath": "on",
    "breadcrumbs.symbolSortOrder": "type",
    "breadcrumbs.showVariables": false,
    "outline.showVariables": false,
    "diffEditor.renderSideBySide": false,
    "debug.disassemblyView.showSourceCode": false,
    // ============================================================
    // TERMINAL SETTINGS
    // ============================================================
    "terminal.integrated.fontFamily": "Liberation Mono",
    "terminal.integrated.allowChords": false,
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.suggest.enabled": false,
    // ============================================================
    // FILE MANAGEMENT
    // ============================================================
    "files.watcherExclude": {
        "**/.tox/**": true,
        "**/node_modules/**": true,
        "**/.git/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.pytest_cache/**": true,
        "**/__pycache__/**": true,
        "**/target/**": true,
        "**/.venv/**": true
    },
    "files.exclude": {
        ".dvs": true,
        ".ruff_cache": true,
        ".venv": true,
        "**/.tox": true
    },
    "files.associations": {
        ".env*": "dotenv"
    },
    "search.exclude": {
        "**/.tox": true
    },
    "search.smartCase": true,
    "explorer.fileNesting.patterns": {
        "Cargo.toml": "Cargo.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    // ============================================================
    // KEYBOARD & KEYBINDINGS
    // ============================================================
    "keyboard.dispatch": "keyCode",
    // ============================================================
    // VIM SETTINGS
    // ============================================================
    "vscode-neovim.compositeKeys": {
        "jk": {
            // Use lua to execute any logic
            "command": "vscode-neovim.lua",
            "args": [
                [
                    "local code = require('vscode')",
                    "code.action('vscode-neovim.escape')",
                    "code.action('workbench.action.files.save')",
                ],
            ],
        },
    },
    "vscode-neovim.neovimExecutablePaths.linux": "/opt/nvim-linux-x86_64/bin/nvim",
    "vscode-neovim.afterInitConfig": [
        "set ignorecase"
    ],
    // "vim.leader": ",",
    // "vim.insertModeKeyBindings": [
